# AgriIntel Environment Variables Configuration Template

# Server / API Gateway Config
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Database
MONGO_URI=mongodb://localhost:27017/agriintel
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/agriintel?retryWrites=true&w=majority

# Microservices URLs (Internal Gateway routing)
ML_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002

# Payments (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Third-party Identity & Communication
DIGILOCKER_CLIENT_ID=your_digilocker_sandbox_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_sandbox_secret
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/auth/digilocker/callback
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# RAG & LLM Engine
OPENAI_API_KEY=your_openai_api_key_or_leave_blank_for_local_ollama
LLM_PROVIDER=openai # openai | claude | ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Frontend Client
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_WS_URL=http://localhost:5000
REACT_APP_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
